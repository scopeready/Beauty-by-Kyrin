# Beauty by Kyrin — environment variables.
#
# Copy to `.env` for local work. Real values are set in Vercel Project Settings,
# never committed. The site builds and the booking form works with NONE of these
# set — every one is an override or an optional enhancement. That is deliberate:
# a lead form that depends on a variable being present is a lead form that can
# ship silently broken.

# --- Build ------------------------------------------------------------------
# Canonical origin. Defaults to https://www.beautybykyrin.com.
SITE_URL=https://www.beautybykyrin.com

# Must be exactly "true" for pages to be indexable. Anything else — including
# unset — emits noindex, which is what every preview deployment should do.
INDEX_SITE=false

# --- Booking form -----------------------------------------------------------
# Web3Forms endpoint key. Server-side only; it is never sent to the browser.
# api/_lib/delivery.mjs falls back to the known key if this is unset, so the
# form cannot ship dead. Set it here only to rotate the key without a commit.
WEB3FORMS_ACCESS_KEY=

# --- Supabase (optional) ----------------------------------------------------
# Leave blank and leads are delivered by email only — never dropped.
# The service role key bypasses RLS. It is SERVER-SIDE ONLY: it must never
# appear in a NEXT_PUBLIC_-style variable or anywhere the browser can read.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Analytics and verification (optional) ----------------------------------
# No tracking script is emitted while NEXT_PUBLIC_GA_ID is blank.
# Never invent a measurement ID — leave it empty until a real property exists.
NEXT_PUBLIC_GA_ID=
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# --- Unconfirmed business inputs (see docs/LAUNCH-INPUTS-NEEDED.md) ---------
# Blank: every CTA reads "Request an Appointment" and points at /book.
# Set to a real booking platform URL and the primary CTA becomes "Book with Kyrin".
NEXT_PUBLIC_BOOKING_URL=

# Blank: the "leave a review" button is hidden entirely.
NEXT_PUBLIC_GBP_REVIEW_URL=
